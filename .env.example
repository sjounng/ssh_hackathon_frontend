# 이 파일을 .env.local로 복사해 값을 채운다 (.env.local은 git에 올라가지 않는다)
# 운영(Vercel)에는 같은 이름으로 Project Settings > Environment Variables에 넣는다

# Supabase: Project Settings > API
SUPABASE_URL=
# 서버 전용 키. 절대 NEXT_PUBLIC_ 접두사를 붙이거나 브라우저 코드에 넣지 않는다
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth 세션 암호화 키: `npx auth secret` 으로 생성
AUTH_SECRET=

# Google OAuth 클라이언트: Google Cloud Console > API 및 서비스 > 사용자 인증 정보
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 메일 발송 (Resend): resend.com > API Keys
RESEND_API_KEY=
# 발신 주소. 도메인 인증 전에는 'onboarding@resend.dev'만 가능(본인 메일로만 수신)
MAIL_FROM=
